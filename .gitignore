node_modules/
.pnpm-store/

# Production
dist/
build/
dist-*/

# Misc
.DS_Store
.env
.env.*
!.env.example
# .env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Taro specific
.taro/

# OS X
.DS_Store

# Key
# ⚠️ 2026-10-26 恢复忽略：此处放小程序代码上传私钥（CI 用），绝不能进版本库。
#    历史提交里的 0 字节占位文件已从索引移除（git rm --cached）。
#    私钥需从 mp 后台下载后放在本机此目录，不要提交。
key/

# Preview files
.preview

# CodeGraph index
.codegraph
node-compile-cache/
/logs
/server/logs/
.codegraph/
.workbuddy/

# 上传的资源包（zip/原始素材），不进版本库
# ⚠️ 前缀斜杠是刻意的：写成 `assets/` 会连带吞掉 src/assets/tabbar/*.png
#    （TabBar 图标，微信小程序强制要求本地 PNG，不能走远程 URL）。
#    现有 8 个图标因早已被 track 侥幸没丢，但**新增**图标会被静默忽略，
#    换机器 clone 后构建直接缺图标。故此处只忽略项目根目录那一层。
/assets/

# Paddle/PaddleOCR 模型缓存（持久化，避免沙箱重置后重复下载）
.cache-paddlex/
.cache-paddle-xdg/
.cache-pip/
.venv-py/

# local 存储驱动对象目录（本机开发，STORAGE_DRIVER=local）
.local-storage/

# 部署打包时临时挪出的本地专属文件（.env.secrets/.env.migrate/.local-storage/logs）
.deploy-staging/

# 部署打包时复制进 server/ 的仓库根依赖（ocr-engine/、docs/），随包上传、不入库
server/ocr-engine/
server/docs/

# WorkBuddy 应用身份文件（平台侧管理，不进版本库）
*.genie

# Python 字节码缓存（py_compile 校验时产生）
__pycache__/

# 微信开发者工具本机设置（打开项目时自动生成）
project.private.config.json

# 构建版本角标数据（scripts/gen-build-meta.mjs 每次构建重新生成）
src/build-meta.ts

# 临时编译产物（分段验证脚本用）
.tmp/

# 数据库备份（含加密后的全量用户数据副本与口令托管文件，绝不入库）
/server/backups/

# 验证套件生成的报告（每次跑都会变，CI 用 artifact 留存）
docs/test/
