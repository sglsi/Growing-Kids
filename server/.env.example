# ============================================================
# Growing-Kids 后端环境变量模板（已彻底去除扣子 / Coze 依赖）
# 用法：复制为 server/.env 并填入真实值（.env 已被 .gitignore，不会提交）
# ============================================================
# ⚠️ 2026-10-20 起改为「敏感项分离 + 加密上传」：
#   server/.env          只放非敏感项（随部署包上传）
#   server/.env.secrets  放敏感密钥（不随包上传；改后必须重跑 encrypt-env.mjs）
#   server/.env.migrate  放 DATABASE_URL（仅本地迁移用，不随包上传）
#   server/.env.secrets.enc  密文（随包上传，容器启动时 decrypt-env.mjs 还原）
# 详见《安全与隐私设计方案.md》「部署包环境变量加密」一节。
#
# 本模板对应 .env（非敏感项）。敏感项模板见 .env.secrets 文件头的注释。

# ---- 数据库（Supabase，公网可达）----
# 获取：supabase.com → 项目 → Project Settings → API
# 注意：ANON_KEY / SERVICE_ROLE_KEY 属敏感项，放 .env.secrets，不写在这里。
SUPABASE_URL=https://xxxxxxxx.supabase.co
# 可选：覆盖内置 Cloudflare 备用 IP 池（逗号分隔）。
# 背景：国内网络会间歇封锁 supabase.co 的官方 Cloudflare IP（TCP 可连但 TLS/HTTP 挂死），
# 后端默认会自动改试内置备用 anycast IP + 真实 DNS 结果兜底；若备用池也失效可在此覆盖。
# SUPABASE_IP_POOL=104.18.38.7,172.64.32.7

# ---- 数据库连接串（迁移执行器用，非 REST key）----
# ⚠️ 真实连接串放 server/.env.migrate（本地专用，不随包上传）；此处为占位模板。
# 获取：Supabase Dashboard → Connect → Direct Connection string → Session pooler（IPv4，国内可达）
# 用途：node server/scripts/migrate.mjs 直连执行 migrations/*.sql
# ⚠️ 这是「含密码的 Postgres 连接串」，与上面的 REST API key 不是一回事
# ⚠️ host 必须是真实可达主机（如 aws-0-ap-southeast-1.pooler.supabase.com），
#    不要写成 <host> / localhost 之类占位符——部署预检靠这行识别「远程数据库」，
#    缺它或 host 不含点会被判为需要本地数据库而拒绝发布（2026-10-20 实测踩坑）
DATABASE_URL=postgresql://postgres.<project-ref>:<密码>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- 对象存储 ----
# STORAGE_DRIVER=local      → 落本机 .local-storage/，经 /api/storage/files/* 读回（开发默认）
# STORAGE_DRIVER=supabase   → Supabase Storage（生产；需先在控制台建 bucket）
# 未设置时：配齐 SUPABASE_URL + SERVICE_ROLE_KEY 自动选 supabase，否则 local
# 注：生产托管必须 supabase——local 的 getPublicUrl 只能拼 http://127.0.0.1:<PORT>，
#     微信 image 组件基础库 3.17.4 起对 HTTP 图片告警/不支持。
STORAGE_DRIVER=local
SUPABASE_STORAGE_BUCKET=media
# 公共桶 true → getPublicUrl 返回公网直链；false → 返回 24h 签名 URL
SUPABASE_STORAGE_PUBLIC=true
# local 驱动专用：对象根目录（默认 <cwd>/.local-storage）
# STORAGE_LOCAL_DIR=
# local 驱动专用：对外访问基址（默认 http://127.0.0.1:<PORT>）
# STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:3001

# ---- 微信登录（小程序后台 → 开发管理 → 开发者密码）----
# AppID 为公开标识（小程序客户端包体内本就含它），可明文随包；
# AppSecret 是敏感项，放 .env.secrets。
WX_APPID=

# ---- 服务端口 ----
# 本地开发默认 3000；托管时由平台注入 PORT
SERVER_PORT=3000

# ---- AI Provider（思傅 2026-10-22：大模型首先用扣子，扣子不能用用 DeepSeek 兜底）----
# 原 coze-coding-dev-sdk 已由 server/src/ai/llm-provider.ts 统一适配层替代：
# 同形接口（LLMClient/SearchClient/FetchClient/ImageGenerationClient），业务代码零改动。
#
# 降级链（llmChain，自动）：
#   ① 扣子 coze       → 需 COZE_API_TOKEN（.env.secrets）
#   ② DeepSeek        → 需 DEEPSEEK_API_KEY（.env.secrets）
#   ③ 腾讯混元 hunyuan → 需 HUNYUAN_API_KEY（.env.secrets）
# 上一级没配 Key 或调用失败，自动降级下一级；顺序可用 LLM_PROVIDER_CHAIN 自定义。
# ⚠️ DeepSeek 官方模型名是 deepseek-v4-flash（"V4.1 flash" 即此）；
#    deepseek-chat / deepseek-reasoner 已于 2026-07-24 弃用，填了会直接报错。
AI_PROVIDER=coze
LLM_PROVIDER_CHAIN=coze,deepseek,hunyuan

# ---- 扣子（第一级，需 OpenAPI 调用）----
# 路线 A（2026-10-22 定）：走扣子标准 OpenAPI（api.coze.cn/v3/chat），PAT 在此路径合法可用。
# 前置：① COZE_API_TOKEN 已填（.env.secrets，pat_ 开头个人访问令牌）
#       ② 一个已「发布为 API 服务」(connector_ids:['API']) 的扣子智能体，其 ID 填到 COZE_BOT_ID
#       ③ 该 PAT 创建时已勾选 bot 所在空间的权限（否则 403）
#       ④ 联网搜索场景需 bot 已开启联网插件（见 ANSWER_SEARCH_PROVIDER）
COZE_BOT_ID=
# 一般留空走国内端点 https://api.coze.cn；海外用 https://api.coze.com
COZE_CN_BASE_URL=
# 单次对话轮询超时（毫秒）
COZE_CHAT_TIMEOUT_MS=120000

# DeepSeek（备用模型）：https://platform.deepseek.com → API Keys
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=120000
# 含图消息默认跳过 DeepSeek（除非给它配视觉模型）
DEEPSEEK_VISION_MODEL=
# 自定义网关时用（一般留空走官方 https://api.deepseek.com）
DEEPSEEK_BASE_URL=

# ---- 腾讯混元（第三级兜底，可留空）----
# Key 获取：https://console.cloud.tencent.com/hunyuan → API Key 管理 → 新建
# HUNYUAN_API_KEY 是敏感项，放 .env.secrets。
HUNYUAN_MODEL=hunyuan-turbos-latest
# 消息含图时自动切换到视觉模型
HUNYUAN_VISION_MODEL=hunyuan-vision-latest
HUNYUAN_TIMEOUT_MS=120000

# ---- 题目答案：联网搜答案（2026-10-21 新增）----
# 设计见「题目答案功能-设计方案.md」：博查真搜索为主，混元大模型为备用兜底。
# 搜索源：bocha（默认，需 Key）/ coze（AI_PROVIDER=coze 时自动优先走扣子 bot 联网）/ none（禁用联网检索，只走模型兜底）
ANSWER_SEARCH_PROVIDER=bocha
# 博查 AI 搜索 Key：https://open.bochaai.com → API KEY 管理
# 敏感项，实际值放 .env.secrets（BOCHA_API_KEY=...）；未配置时自动降级为模型兜底，
# 并在返回里标注「未联网核实」，绝不伪造检索结果。
BOCHA_API_KEY=
# 每用户每日搜题次数上限（防刷、控成本）
ANSWER_SEARCH_DAILY_LIMIT=20
# 扣子联网搜的单次轮询超时（毫秒）：bot 真跑检索插件实测 100~115s，
# 默认 120s 擦线必挂，故搜索端单独放宽到 180s（不改全局 COZE_CHAT_TIMEOUT_MS，
# 避免拖慢普通对话的失败降级）。
ANSWER_SEARCH_COZE_TIMEOUT_MS=180000

# ---- 题目答案：ima 知识库检索（2026-10-23 新增，思傅：解决联网搜题 83s 太慢）----
# 第三种解题来源：只检索 ima 知识库（秒级），不喂给 AI；未配置时前端「知识库」按钮
# 会返回明确配置指引，绝不静默降级成别的方式。
# 三个都是敏感项，实际值放 .env.secrets；改后必须重跑：
#   node server/scripts/encrypt-env.mjs && 重启后端
# 获取方式：https://ima.qq.com/agent-interface （API Key 只显示一次，注意保存）
#   IMA_CLIENT_ID / IMA_API_KEY —— 开放平台凭据（两个自定义 HTTP 头传给 ima.qq.com）
#   IMA_KB_ID                   —— 知识库 ID（ima 客户端 → 知识库设置里查看）。
#                                   **支持逗号分隔多库**：多库并行检索、按各库相关序
#                                   交错合并 + 按标题去重；部分库失败不拖垮整体。
#                                   思傅 2026-10-23 选定 6 个 K12 订阅库（见 .env.secrets）。
IMA_CLIENT_ID=
IMA_API_KEY=
IMA_KB_ID=
# 单次检索超时（毫秒）：ima 是腾讯自家服务，本机实测 <1s，默认 15s 足够
IMA_SEARCH_TIMEOUT_MS=15000
