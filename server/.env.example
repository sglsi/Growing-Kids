# ============================================================
# Growing-Kids 后端环境变量模板
# 用法：复制为 server/.env 并填入真实值（.env 已被 .gitignore，不会提交）
# 值获取途径见 docs/迁移到腾讯云-方案与步骤.md §3 / §5
# ============================================================

# ---- 数据库（Supabase，公网可达）----
# 获取：supabase.com → 项目 → Project Settings → API
# 密钥格式说明（2025-10 起新版 API keys）：
#   publishable key（sb_publishable_ 前缀）→ 填 ANON_KEY
#   secret key（sb_secret_ 前缀，点 Reveal 显示）→ 填 SERVICE_ROLE_KEY
# 注意：SERVICE_ROLE_KEY 缺失时后端退化为 publishable key；
#       当前 schema 未启用 RLS 故功能可用，但设计态要求 secret key
COZE_SUPABASE_URL=https://xxxxxxxx.supabase.co
COZE_SUPABASE_ANON_KEY=
COZE_SUPABASE_SERVICE_ROLE_KEY=

# ---- 对象存储（扣子 bucket；迁腾讯云后换成 COS_SECRET_ID/KEY + COS_BUCKET/REGION）----
# 获取：扣子平台项目设置 → 环境变量
COZE_BUCKET_ENDPOINT_URL=
COZE_BUCKET_NAME=

# ---- 微信登录（小程序后台 → 开发管理 → 开发者密码）----
WX_APPID=
WX_SECRET=

# ---- 服务端口 ----
# 本地开发默认 3000；WorkBuddy 托管时由平台注入 PORT（需 main.ts 支持，见迁移方案）
SERVER_PORT=3000

# ---- 扣子 PAT（2026-10-17 实测不可用，仅存档说明）----
# SDK 模型端点只认 JWT 格式令牌（平台运行时注入的 workload identity），
# 控制台 PAT（pat_ 前缀）在解析阶段即被拒；AI 功能需换混元，见迁移方案 §5
# COZE_API_TOKEN=
