loglevel=error
registry=https://registry.npmmirror.com

# 兜底：npm 8+ 严格 peer 依赖解析会让本项目的 miniprogram-ci(^2.1.26)
# 与 @tarojs/plugin-mini-ci@4.1.9 的 peer(^1.9.15) 冲突而 ERESOLVE 失败。
# 本项目日常用 pnpm 开发，npm 仅被「小程序发布」流水线调用，故在此放宽 peer 解析。
legacy-peer-deps=true

strictStorePkgContentCheck=false
verifyStoreIntegrity=false

network-concurrency=16
fetch-retries=3
fetch-timeout=60000

strict-peer-dependencies=false

auto-install-peers=true

lockfile=true
prefer-frozen-lockfile=true

resolution-mode=highest

# 不提示 npm 更新
update-notifier=false

# ⚠️ Taro 的 babel 插件是从「项目根目录」解析的（报错里的
# babel-virtual-resolve-base.js 就是它），而 pnpm 默认严格布局只把**直接依赖**
# 链接到 node_modules/@babel/ 下 —— 于是 Taro 需要的
# @babel/plugin-proposal-decorators 等传递依赖解析不到，
# 构建直接崩：Error: Cannot find package '@babel/plugin-proposal-decorators'。
# public-hoist-pattern 把 @babel/* 提升到根 node_modules，一次性解决整类问题。
public-hoist-pattern[]=@babel/*
public-hoist-pattern[]=*babel*
